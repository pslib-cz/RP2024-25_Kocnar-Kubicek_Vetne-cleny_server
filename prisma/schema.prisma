// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./../database.sqlite"
}

model Game {
  id             String   @id @default(uuid())
  active         Boolean  @default(true)
  code           Int      
  difficulty     Int
  galaxy         Int
  questiontypes  Int
  version        String
  seed           String?
  expirationTime DateTime
  authorId       String
  author         Player   @relation("GameAuthor", fields: [authorId], references: [id])
  activePlayers  Player[] @relation("GameToPlayers")
  sessions       GameSession[]
  createdAt      DateTime @default(now())
  @@unique([code, active])
}

model Player {
  id                 String         @id // Client-provided ID
  name               String
  bodyColor          String
  trailColor         String
  selectedRocketIndex Int
  clientVersion      String
  secretKey          String         @unique
  authoredGames      Game[]         @relation("GameAuthor")
  sessions           GameSession[]
  activeGame         Game?          @relation("GameToPlayers", fields: [activeGameId], references: [id])
  activeGameId       String?
}

model GameSession {
  id              String   @id @default(uuid())
  playerId        String
  gameId          String
  player          Player   @relation(fields: [playerId], references: [id])
  game            Game     @relation(fields: [gameId], references: [id])
  score           Int      @default(0)
  correctAnswers  Int      @default(0)
  completed       Boolean  @default(false)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
}
